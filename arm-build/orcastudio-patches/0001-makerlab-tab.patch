+#ifndef slic3r_MakerLabPanel_hpp_
+#define slic3r_MakerLabPanel_hpp_
+
+#include <string>
+#include <wx/panel.h>
+#include <wx/webview.h>
+
+namespace Slic3r {
+namespace GUI {
+
+// MakerWorld's MakerLab tools (makerworld.com/makerlab) in a tab of their own, signed in with
+// the Bambu account the same way Bambu Studio does it: a bind ticket from the network plugin
+// is exchanged at <host>api/sign-in/ticket. Models the tools generate come back as base64
+// 3MF/STL script messages; only the commands MakerLab uses are accepted from this page.
+class MakerLabPanel : public wxPanel
+{
+public:
+    MakerLabPanel(wxWindow *parent);
+    ~MakerLabPanel() override;
+
+    // Loads the page on first show and reloads it when the Bambu sign-in state changed.
+    bool Show(bool show = true) override;
+
+private:
+    void load_page();
+    void request_login();
+    void on_script_message(wxWebViewEvent &evt);
+    void on_new_window(wxWebViewEvent &evt);
+    void open_3mf(const std::string &base64, const std::string &name);
+    void save_stl(int sequence_id, const std::string &base64, const std::string &name);
+    // Decodes base64 into <download folder>/<sanitized name>_<time>.<ext>; returns the UTF-8 path or "".
+    std::string save_base64(const std::string &base64, const std::string &name, const std::string &ext);
+
+    wxWebView *m_browser{nullptr};
+    bool       m_loaded{false};
+    bool       m_loaded_signed_in{false};
+};
+
+} // namespace GUI
+} // namespace Slic3r
+
+#endif // slic3r_MakerLabPanel_hpp_
