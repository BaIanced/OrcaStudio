index 00000000..52167799
--- /dev/null
+++ b/src/slic3r/GUI/MakerLabPanel.cpp
@@ -0,0 +1,221 @@
+#include "MakerLabPanel.hpp"
+
+#include "GUI_App.hpp"
+#include "Widgets/WebView.hpp"
+#include "slic3r/Utils/BBLNetworkPlugin.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <ctime>
+#include <set>
+
+#include <boost/filesystem.hpp>
+#include <boost/log/trivial.hpp>
+#include <boost/nowide/fstream.hpp>
+#include <nlohmann/json.hpp>
+#include <wx/base64.h>
+#include <wx/filename.h>
+#include <wx/sizer.h>
+
+using json = nlohmann::json;
+
+namespace Slic3r {
+namespace GUI {
+
+MakerLabPanel::MakerLabPanel(wxWindow *parent) : wxPanel(parent, wxID_ANY, wxDefaultPosition, wxDefaultSize)
+{
+    auto *sizer = new wxBoxSizer(wxVERTICAL);
+    m_browser   = WebView::CreateWebView(this, "");
+    if (m_browser == nullptr) {
+        BOOST_LOG_TRIVIAL(error) << "MakerLab: could not create the web view";
+        return;
+    }
+    m_browser->Bind(wxEVT_WEBVIEW_SCRIPT_MESSAGE_RECEIVED, &MakerLabPanel::on_script_message, this);
+    m_browser->Bind(wxEVT_WEBVIEW_NEWWINDOW, &MakerLabPanel::on_new_window, this);
+    sizer->Add(m_browser, wxSizerFlags().Expand().Proportion(1));
+    SetSizer(sizer);
+}
+
+MakerLabPanel::~MakerLabPanel()
+{
+    SetEvtHandlerEnabled(false);
+    if (m_browser) {
+        m_browser->Destroy();
+        m_browser = nullptr;
+    }
+}
+
+bool MakerLabPanel::Show(bool show)
+{
+    if (show && m_browser && (!m_loaded || m_loaded_signed_in != wxGetApp().is_user_login(BBL_CLOUD_PROVIDER)))
+        load_page();
+    return wxPanel::Show(show);
+}
+
+void MakerLabPanel::load_page()
+{
+    // Same URLs as Bambu Studio (WebViewPanel::SetMakerlabUrl / GetJumpUrl).
+    const std::string host   = wxGetApp().get_model_http_url(wxGetApp().app_config->get_country_code());
+    const std::string target = host + "makerlab?from=bambustudio";
+
+    // The ticket comes from the Bambu network plugin itself, not from the selected printer's
+    // agent, so MakerLab stays signed in while a non-Bambu printer is selected.
+    std::string url;
+    bool        signed_in = wxGetApp().is_user_login(BBL_CLOUD_PROVIDER);
+    if (signed_in) {
+        std::string ticket;
+        int         ret = -1;
+        {
+            auto &plugin      = BBLNetworkPlugin::instance();
+            auto  module_lock = BBLNetworkPlugin::lock_module_for_call();
+            auto  agent       = plugin.get_agent();
+            auto  func        = plugin.get_request_bind_ticket();
+            if (agent && func)
+                ret = func(agent, &ticket);
+        }
+        if (ret == 0 && !ticket.empty())
+            url = host + "api/sign-in/ticket?to=" + wxGetApp().url_encode(target) + "&ticket=" + ticket;
+        else {
+            BOOST_LOG_TRIVIAL(warning) << "MakerLab: request_bind_ticket failed (" << ret << "), loading signed out";
+            signed_in = false;
+        }
+    }
+    // Signed out: also end a stale MakerWorld web session.
+    if (url.empty())
+        url = host + "api/sign-out?to=" + wxGetApp().url_encode(target);
+
+    m_loaded           = true;
+    m_loaded_signed_in = signed_in;
+    WebView::LoadUrl(m_browser, wxString::FromUTF8(url));
+}
+
+void MakerLabPanel::request_login()
+{
+    // ZUserLogin runs modally, so the sign-in state is known when request_login returns.
+    wxGetApp().request_login(true, BBL_CLOUD_PROVIDER);
+    if (m_loaded_signed_in != wxGetApp().is_user_login(BBL_CLOUD_PROVIDER))
+        load_page();
+}
+
+void MakerLabPanel::on_new_window(wxWebViewEvent &evt)
+{
+    const wxString url = evt.GetURL();
+    if (!url.empty())
+        wxGetApp().open_browser_with_warning_dialog(url);
+    evt.Veto();
+}
+
+void MakerLabPanel::on_script_message(wxWebViewEvent &evt)
+{
+    // Remote content: accept only what MakerLab uses (Bambu Studio's kMakerLabAllowed) and
+    // handle it here instead of passing it to GUI_App::handle_web_request.
+    json j;
+    try {
+        j = json::parse(evt.GetString().ToUTF8().data());
+    } catch (const std::exception &) {
+        BOOST_LOG_TRIVIAL(warning) << "MakerLab: script message is not JSON";
+        return;
+    }
+    if (!j.is_object() || !j.contains("command") || !j["command"].is_string())
+        return;
+    const std::string cmd = j["command"].get<std::string>();
+    auto str = [&j](const char *key) {
+        return j.contains(key) && j[key].is_string() ? j[key].get<std::string>() : std::string();
+    };
+
+    if (cmd == "homepage_makerlab_open_3mf_binary") {
+        const std::string data = str("3mf");
+        if (!data.empty())
+            open_3mf(data, str("3mf_name"));
+    } else if (cmd == "homepage_makerlab_stl_download") {
+        const std::string data = str("file_data");
+        int               seq  = -1;
+        if (j.contains("sequence_id")) {
+            if (j["sequence_id"].is_number_integer())
+                seq = j["sequence_id"].get<int>();
+            else if (j["sequence_id"].is_string())
+                seq = std::atoi(j["sequence_id"].get<std::string>().c_str());
+        }
+        if (!data.empty() && seq >= 0)
+            save_stl(seq, data, str("file_name"));
+    } else if (cmd == "common_openurl") {
+        const std::string url = str("url");
+        if (!url.empty())
+            wxGetApp().open_browser_with_warning_dialog(wxString::FromUTF8(url));
+    } else if (cmd == "makerworld_model_open") {
+        if (j.contains("model") && j["model"].is_object() && j["model"].contains("url") && j["model"]["url"].is_string())
+            wxGetApp().request_model_download(wxString::FromUTF8(wxGetApp().url_decode(j["model"]["url"].get<std::string>())));
+    } else if (cmd == "homepage_login_or_register") {
+        CallAfter([this] { request_login(); });
+    } else {
+        BOOST_LOG_TRIVIAL(warning) << "MakerLab: blocked web command " << (cmd.size() > 64 ? cmd.substr(0, 64) : cmd);
+    }
+}
+
+void MakerLabPanel::open_3mf(const std::string &base64, const std::string &name)
+{
+    const std::string path = save_base64(base64, name, "3mf");
+    if (!path.empty())
+        wxGetApp().request_open_project(path);
+}
+
+void MakerLabPanel::save_stl(int sequence_id, const std::string &base64, const std::string &name)
+{
+    const std::string path = save_base64(base64, name, "stl");
+    // The page waits for this reply (same shape as Bambu Studio's SaveMakerlabStl).
+    json reply;
+    reply["sequence_id"] = sequence_id;
+    reply["command"]     = "homepage_makerlab_stl_download";
+    reply["file_name"]   = name;
+    reply["result"]      = path.empty() ? "fail" : "success";
+    const wxString js    = wxString::Format("window.postMessage(%s)",
+                                            wxString::FromUTF8(reply.dump(-1, ' ', false, json::error_handler_t::ignore)));
+    CallAfter([this, js] {
+        if (m_browser)
+            WebView::RunScript(m_browser, js);
+    });
+}
+
+std::string MakerLabPanel::save_base64(const std::string &base64, const std::string &name, const std::string &ext)
+{
+    const wxMemoryBuffer data = wxBase64Decode(base64.c_str(), base64.size(), wxBase64DecodeMode_SkipWS);
+    if (data.GetDataLen() == 0) {
+        BOOST_LOG_TRIVIAL(error) << "MakerLab: invalid base64 " << ext << " data";
+        return {};
+    }
+
+    // Keep only the base name, without folders or extension, and only safe characters.
+    std::string stem = boost::filesystem::path(name).filename().stem().string();
+    stem.erase(std::remove_if(stem.begin(), stem.end(),
+                              [](unsigned char c) { return !(std::isalnum(c) || c == '-' || c == '_' || c == ' '); }),
+               stem.end());
+    if (stem.size() > 64)
+        stem.resize(64);
+    if (stem.empty())
+        stem = "makerlab";
+
+    wxString dir = wxString::FromUTF8(wxGetApp().app_config->get("download_path"));
+    if (dir.empty() || !wxFileName::DirExists(dir))
+        dir = wxFileName::GetTempDir();
+
+    char         stamp[32];
+    const time_t now = time(nullptr);
+    strftime(stamp, sizeof(stamp), "%Y%m%d_%H%M%S", localtime(&now));
+    wxFileName file(dir, wxString::FromUTF8(stem + "_" + stamp), wxString::FromUTF8(ext));
+    for (int i = 1; file.FileExists() && i < 100; ++i)
+        file.SetName(wxString::FromUTF8(stem + "_" + stamp + "_" + std::to_string(i)));
+
+    const std::string path = file.GetFullPath().utf8_string();
+    boost::nowide::ofstream out(path, std::ios::binary | std::ios::trunc);
+    out.write(static_cast<const char *>(data.GetData()), std::streamsize(data.GetDataLen()));
+    out.close();
+    if (!out) {
+        BOOST_LOG_TRIVIAL(error) << "MakerLab: could not write " << path;
+        return {};
+    }
+    BOOST_LOG_TRIVIAL(info) << "MakerLab: saved " << path << " (" << data.GetDataLen() << " bytes)";
+    return path;
+}
+
+} // namespace GUI
+} // namespace Slic3r
