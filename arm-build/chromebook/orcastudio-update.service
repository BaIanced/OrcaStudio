[Unit]
Description=Install the newest aarch64 OrcaStudio Flatpak from BaIanced/orcastudio releases
Documentation=https://github.com/BaIanced/orcastudio/blob/main/arm-build/NOTES-updates.md
# A user manager cannot order itself after the system's network-online.target.
# The script retries network access itself (curl --retry 5, 30 s apart) and
# exits 75 if the network stays down; Restart= below tries again later.
StartLimitIntervalSec=6h
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=%h/.local/bin/orcastudio-update.sh --quiet
# Retry only temporary failures (75 = network / rate limit, including a
# failed Flathub fetch during `flatpak install --bundle`). Exit 1 (checksum
# mismatch, non-network install failure) and 2 (usage) are not retried.
# A failed install never removes the installed version.
Restart=on-failure
RestartSec=20min
RestartPreventExitStatus=1 2
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
